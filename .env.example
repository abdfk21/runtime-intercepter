# Environment Configuration for Runtime Interceptor
# Copy this file to .env and provide keys if using external providers.
# DO NOT commit .env with secrets.

# Google AI Studio / Gemini API (Optional for real API testing)
GEMINI_API_KEY=

# Groq API (Optional for real API testing)
GROQ_API_KEY=

# Ollama Configuration (Local LLM - Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Default Provider for CLI and Demo: "mock", "gemini", "groq", or "ollama"
DEFAULT_PROVIDER=mock

# Database Connection (Defaults to SQLite in data/interceptor.db if blank)
DATABASE_URL=sqlite:///./data/interceptor.db

# Application & API Server
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Interceptor Global Configuration
INTERCEPTOR_MODE=active
RANDOM_SEED=42
